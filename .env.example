# ============================================================
# KPI Project — Environment Variables
# Copy this file to .env and adjust values before running
# docker-compose --env-file .env up -d
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kpi_dev
POSTGRES_PORT=5556          # host port (avoid conflict with wtm which uses 5555)

# --- Redis ---
REDIS_PORT=6380             # host port (avoid conflict with wtm which uses 6379)

# --- Backend ---
BACKEND_PORT=8081           # host port (avoid conflict with wtm which uses 8080)

# --- pgAdmin ---
PGADMIN_EMAIL=admin@kpi.dev
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050          # truy cập http://localhost:5050

# --- JWT ---
JWT_SECRET=changeme_use_a_long_random_secret_in_production
JWT_ACCESS_EXPIRATION=3600000      # 1 hour  (ms)
JWT_REFRESH_EXPIRATION=604800000   # 7 days  (ms)
